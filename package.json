{
  "name": "specwitness",
  "version": "0.1.0",
  "description": "Independent verification gate for agentic software development: proves, with reproducible evidence, whether an assembled epic satisfies its frozen specification.",
  "keywords": [
    "verification",
    "agentic",
    "cli",
    "bmad",
    "quality-gate"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "specwitness": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:corpus": "vitest run tests/corpus",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile=.vitest-report.json",
    "test:browser": "vitest run tests/integration/surfaces/browser tests/integration/surfaces/conformance --reporter=default --reporter=json --outputFile=.vitest-browser-report.json",
    "provision:browser": "vitest run --config vitest.provision.config.ts",
    "report:skips": "node scripts/report-skipped-suites.mjs .vitest-report.json",
    "report:skips:browser": "node scripts/report-skipped-suites.mjs .vitest-browser-report.json",
    "test:watch": "vitest",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "pnpm run depcruise"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": "1.62.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "dependency-cruiser": "^18.2.0",
    "fast-check": "^4.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
